# ── Database ──────────────────────────────────────────────────────────────────
# Neon free tier: https://neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-32-char-random-string"
NEXTAUTH_URL="https://eallsource.com"

# ── Encryption (for stored Amazon SP-API credentials) ─────────────────────────
# Generate: openssl rand -base64 32
ENCRYPTION_KEY="replace-with-32-char-random-string"

# ── Retailers: Apify ──────────────────────────────────────────────────────────
# https://console.apify.com/account/integrations
APIFY_TOKEN=""

# ── Amazon SP-API (optional — enables live matching + fee estimates) ───────────
# Published SP-API application ID from Developer Central (amzn1.sp.solution.* or amzn1.sellerapps.app.*)
# Used as application_id on the Seller Central OAuth consent URL — NOT a secret.
AMAZON_SP_APP_ID=""
# LWA OAuth2 credentials — used for token exchange only (NOT used as application_id).
LWA_CLIENT_ID=""
LWA_CLIENT_SECRET=""
AMAZON_CLIENT_ID=""
AMAZON_CLIENT_SECRET=""
AMAZON_MARKETPLACE_ID="ATVPDKIKX0DER"

# ── Keepa (optional — enables BSR + price history enrichment) ─────────────────
# https://keepa.com/#!api
KEEPA_API_KEY=""

# ── Redis (optional — enables BullMQ job queue + caching) ─────────────────────
# Upstash free tier: https://upstash.com
REDIS_URL="rediss://default:xxx@xxx.upstash.io:6379"

# ── Stripe (optional — enables billing/subscriptions) ─────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_STARTER_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""
STRIPE_ENTERPRISE_PRICE_ID=""

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://eallsource.com"
NEXT_PUBLIC_APP_NAME="Arbitrage Pro AI"
