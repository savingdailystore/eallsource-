# ── Database (use Neon free tier: neon.tech) ─────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-32-char-random-string"
# Set to your Vercel deployment URL (e.g. https://eallsource.vercel.app)
NEXTAUTH_URL="https://your-app.vercel.app"

# ── Redis (optional — Upstash free tier: upstash.com) ────────────────────────
# App works without Redis, just no caching
REDIS_URL="rediss://default:xxx@xxx.upstash.io:6379"

# ── Amazon SP-API (optional — for live repricer) ─────────────────────────────
AMAZON_CLIENT_ID=""
AMAZON_CLIENT_SECRET=""
AMAZON_REFRESH_TOKEN=""
AMAZON_MARKETPLACE_ID="ATVPDKIKX0DER"

# ── Third-party APIs (optional) ──────────────────────────────────────────────
KEEPA_API_KEY=""
RAKUTEN_API_KEY=""

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
NEXT_PUBLIC_APP_NAME="EALLsource"
