generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model ProductRaw {
  id        String   @id @default(cuid())
  asin      String
  title     String?
  price     Float?
  url       String
  rawData   Json
  createdAt DateTime @default(now())

  @@index([asin])
  @@map("products_raw")
}

model Product {
  id        String   @id @default(cuid())
  asin      String
  title     String
  price     Float
  fees      Float
  profit    Float
  roi       Float
  score     Float
  createdAt DateTime @default(now())

  leads Lead[]

  @@index([asin])
  @@index([score])
  @@index([roi])
}

model Lead {
  id        String   @id @default(cuid())
  productId String
  score     Float
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([score])
}

model ScrapeJob {
  id        String   @id @default(cuid())
  type      String
  url       String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@index([status])
  @@map("scrape_jobs")
}
