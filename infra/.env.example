# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://eallsource:eallsource@localhost:5432/eallsource"
# For Neon (production):
# DATABASE_URL="postgresql://neondb_owner:xxxx@ep-xxx.neon.tech/neondb?sslmode=require"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
# For Upstash (production):
# REDIS_URL="rediss://default:xxxx@global-xxx.upstash.io:6379"

# ─── Auth ─────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_STARTER_PRICE_ID="price_..."
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_ENTERPRISE_PRICE_ID="price_..."

# ─── Encryption (Amazon SP-API token storage) ─────────────────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY="your-64-char-hex-key"

# ─── Admin seed ───────────────────────────────────────────────────────────────
ADMIN_EMAIL="your-admin-email@example.com"
ADMIN_PASSWORD="set-a-strong-password-here"

# ─── Docker only ──────────────────────────────────────────────────────────────
POSTGRES_USER=eallsource
POSTGRES_PASSWORD=eallsource
POSTGRES_DB=eallsource
REDIS_PASSWORD=eallsource
