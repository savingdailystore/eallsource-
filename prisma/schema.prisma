generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────

model User {
  id               String          @id @default(cuid())
  name             String?
  email            String          @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  role             Role            @default(USER)
  subscriptionPlan SubscriptionPlan @default(FREE)
  subscriptionEnds DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  accounts         Account[]
  sessions         Session[]
  savedProducts    SavedProduct[]
  weeklyReports    WeeklyReport[]
  repricerRules    RepricerRule[]
  repricerLogs     RepricerLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// Products
// ─────────────────────────────────────────────

model Product {
  id                   String      @id @default(cuid())
  asin                 String      @unique
  upc                  String?
  name                 String
  category             String
  imageUrl             String?

  // Source info
  sourceUrl            String
  sourceRetailer       String
  sourcePrice          Float
  availableDiscounts   Json        @default("[]") // DiscountItem[]
  discountSources      String[]
  finalCost            Float

  // Amazon pricing
  amazonUrl            String
  buyBoxPrice          Float?
  lowestListedPrice    Float?
  estimatedResellPrice Float

  // Fees & calculations
  amazonFees           Float
  prepFee              Float
  taxAmount            Float
  netProfit            Float
  roi                  Float

  // BSR
  bsr                  Int?
  bsrPercentage        Float?
  bsrTrend             String?   // 'TRENDING_UP' | 'TRENDING_DOWN' | 'STABLE'
  categoryRank         Int?      // rank within sub-category
  categoryRankName     String?   // sub-category name, e.g. "Electric Toothbrushes"
  seasonality          String?   // 'YEAR_ROUND' | 'PEAK_SEASON' | 'OFF_SEASON' | 'TRENDING'

  // Seller competition
  fbaSellers           Int         @default(0)
  totalSellers         Int         @default(0)
  autoUngated          Boolean     @default(false)
  buyBoxOwner          BuyBoxOwner @default(FBA_SELLER)
  amazonIsSeller       Boolean     @default(false)
  amazonOwnsBuyBox     Boolean     @default(false)

  // IP Risk
  ipRiskScore          IpRiskLevel @default(LOW)
  ipRiskReasons        String[]

  // Exclusion flags
  hasBrandGating       Boolean     @default(false)
  hasCounterfeitRisk   Boolean     @default(false)
  isHazmat             Boolean     @default(false)
  isRestrictedCategory Boolean     @default(false)

  // Keepa
  keepaLink            String?

  // Status
  status               ProductStatus @default(ACTIVE)
  weeklyBatchId        String?
  dateAdded            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  savedBy              SavedProduct[]
  weeklyBatch          WeeklyBatch?   @relation(fields: [weeklyBatchId], references: [id])

  @@index([asin])
  @@index([category])
  @@index([roi])
  @@index([bsr])
  @@index([dateAdded])
}

model SavedProduct {
  id             String    @id @default(cuid())
  userId         String
  productId      String
  notes          String?
  tags           String[]
  isPurchased    Boolean   @default(false)
  purchaseDate   DateTime?
  purchaseQty    Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ─────────────────────────────────────────────
// Weekly Batches
// ─────────────────────────────────────────────

model WeeklyBatch {
  id          String      @id @default(cuid())
  weekNumber  Int
  year        Int
  status      BatchStatus @default(PENDING)
  totalFound  Int         @default(0)
  totalPassed Int         @default(0)
  createdAt   DateTime    @default(now())
  completedAt DateTime?

  products     Product[]
  weeklyReports WeeklyReport[]

  @@unique([weekNumber, year])
}

model WeeklyReport {
  id          String   @id @default(cuid())
  userId      String
  batchId     String
  generatedAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch WeeklyBatch @relation(fields: [batchId], references: [id])
}

// ─────────────────────────────────────────────
// Scanner / Sources
// ─────────────────────────────────────────────

model RetailerSource {
  id          String   @id @default(cuid())
  name        String   @unique
  baseUrl     String
  enabled     Boolean  @default(true)
  scrapeConfig Json    @default("{}")
  lastScanned DateTime?
  createdAt   DateTime @default(now())
}

model RepricerRule {
  id           String   @id @default(cuid())
  userId       String
  asin         String
  sku          String
  productName  String
  minPrice     Float
  maxPrice     Float
  strategy     String   // 'WIN_BUY_BOX' | 'MAXIMIZE_PROFIT' | 'STAY_COMPETITIVE' | 'FLOOR_PRICE'
  targetMargin Float?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs RepricerLog[]

  @@unique([userId, sku])
}

model RepricerLog {
  id              String   @id @default(cuid())
  userId          String
  ruleId          String?
  asin            String
  sku             String
  productName     String
  oldPrice        Float
  newPrice        Float
  strategy        String
  reason          String
  action          String   // 'INCREASE' | 'DECREASE' | 'HOLD'
  competitorPrice Float?
  buyBoxPrice     Float?
  createdAt       DateTime @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule RepricerRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
}

model ScanLog {
  id          String     @id @default(cuid())
  retailer    String
  status      ScanStatus @default(RUNNING)
  productsFound Int      @default(0)
  productsPassed Int     @default(0)
  errorMessage String?
  startedAt   DateTime   @default(now())
  completedAt DateTime?
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum BuyBoxOwner {
  AMAZON
  FBA_SELLER
  FBM_SELLER
  NONE
}

enum IpRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
  FLAGGED
}

enum BatchStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ScanStatus {
  RUNNING
  COMPLETED
  FAILED
}
