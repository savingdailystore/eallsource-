generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum Plan {
  STARTER
  PRO
  ENTERPRISE
}

enum Role {
  OWNER
  ADMIN
  ANALYST
  VIEWER
}

enum LeadStatus {
  NEW
  SAVED
  PURCHASED
  REJECTED
  EXPIRED
}

enum DemandLevel {
  LOW
  MEDIUM
  HIGH
  UNKNOWN // no BSR/sales-rank data returned — distinct from a confirmed weak rank
}

enum GatingRisk {
  LOW
  MEDIUM
  HIGH
}

// ─── Multi-Tenant Core ─────────────────────────────────────────────────────

model Organization {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  plan              Plan     @default(STARTER)
  scanEnabled       Boolean  @default(false)
  isBroadcastSource Boolean  @default(false)
  receiveBroadcast  Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users          User[]
  subscription   Subscription?
  products       Product[]
  leads          Lead[]
  inventory      InventoryItem[]
  repricingRules RepricingRule[]
  scanJobs       ScanJob[]
  savedSearches  SavedSearch[]
  amazonCred     AmazonCredential?
  auditLogs      AuditLog[]

  @@index([slug])
  @@map("organizations")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(ANALYST)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  passwordChangedAt DateTime @default(now())
  mfaEnabled        Boolean  @default(false)
  mfaSecret         String?  // AES-256-GCM encrypted TOTP secret

  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([orgId])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // SHA-256 of the token sent in the email; raw token never stored
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Subscription {
  id                String   @id @default(cuid())
  orgId             String   @unique
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stripeCustomerId  String?  @unique
  stripeSubId       String?  @unique
  plan              Plan     @default(STARTER)
  status            String   @default("trialing")
  currentPeriodEnd  DateTime?
  trialEndsAt       DateTime?
  cancelAtPeriodEnd Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  billingEvents BillingEvent[]

  @@map("subscriptions")
}

model BillingEvent {
  id             String   @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  stripeEventId  String   @unique
  type           String
  data           Json?
  createdAt      DateTime @default(now())

  @@map("billing_events")
}

// ─── Products & Leads ──────────────────────────────────────────────────────

model Product {
  id    String @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Identifiers
  asin  String
  upc   String?
  ean   String?
  model String?
  brand String?

  // Product info
  title    String
  category String?
  imageUrl String?

  // Source data
  sourceUrl       String?
  sourceRetailer  String?
  sourcePrice     Float?
  sourceListPrice Float?   // original "was" price before markdown
  onSale          Boolean? // retailer flagged on sale / rollback / clearance
  sourceTax       Float?
  sourceShipping  Float?

  // Discounts applied
  availableDiscounts Json? // { source, type, amount, percentage?, code? }[]
  discountSources    Json? // string[]
  finalCost          Float?

  // Amazon pricing data
  amazonUrl            String?
  buyBoxPrice          Float?
  lowestFbaPrice       Float?
  estimatedResellPrice Float?

  // Fee breakdown
  amazonFees      Float?
  referralFee     Float?
  fbaFee          Float?
  storageFee      Float?
  prepFee         Float?
  taxAmount       Float?
  totalLandedCost Float?

  // Computed profitability
  price  Float @default(0)
  fees   Float @default(0)
  profit Float @default(0)
  roi    Float @default(0)
  margin Float?

  // Sales rank
  bsr           Int?
  bsrPercentage Float?

  // Sales velocity
  monthlySales           Int?   // estimated units sold per month (Keepa)
  expectedUnitsPerSeller Float? // monthlySales / (fbaSellers + 1) — your share

  // Seller / competition data
  buyBoxOwner      String?
  fbaSellers       Int?
  totalSellers     Int?
  amazonIsSeller   Boolean @default(false)
  amazonOwnsBuyBox Boolean @default(false)
  buyBoxSuppressed Boolean @default(false)
  isVariation      Boolean @default(false)
  parentAsin       String?
  roiImplausible   Boolean @default(false) // ROI high enough to suggest a bad match — verify
  rating           Float?  // average star rating (0–5)
  reviewCount      Int?    // total ratings/reviews on the listing
  lowReviews       Boolean @default(false) // few reviews — new/unestablished listing risk

  // Validation scores (all must be >= 95 to pass)
  matchMethod      String?
  matchConfidence  Float?
  identityScore    Float?
  urlScore         Float?
  priceScore       Float?
  inventoryScore   Float?
  validationPassed Boolean @default(false)

  // Gating & risk
  autoUngated       Boolean    @default(false)
  ipRiskScore       String     @default("LOW")
  gatingRisk        GatingRisk @default(LOW)
  hasHazmat         Boolean    @default(false)
  isBrandRestricted Boolean    @default(false)
  isCategoryGated   Boolean    @default(false)
  isPrivateLabel    Boolean    @default(false)
  isGenericBrand    Boolean    @default(false)
  isMeltable        Boolean    @default(false)
  feeEstimateConfirmed Boolean @default(false)

  // Real per-ASIN IP complaint history — set manually by an owner after an
  // actual takedown/complaint, not inferred. Once set, permanently blocks the
  // ASIN from becoming a lead again (broadcast-wide, same as the brand-name
  // heuristic but based on a confirmed incident instead of a guess).
  hasIpComplaintHistory Boolean @default(false)
  ipComplaintNote       String?

  // Demand & price stability
  demandLevel    DemandLevel @default(MEDIUM)
  priceStability String?
  priceTrend     String?  // RISING | FLAT | DECLINING | UNKNOWN
  priceTrendPct  Float?   // % change recent vs earlier window (negative = falling)

  // External links
  keepaLink String?

  // Free-text sourcing notes (promo codes, cart-quantity tricks, per-unit math).
  // Shared with all orgs — broadcast along with the rest of the product data.
  notes String?

  // Final lead score (0–100)
  score Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]

  @@unique([orgId, asin])
  @@index([orgId])
  @@index([orgId, score])
  @@index([orgId, roi])
  @@index([orgId, createdAt])
  @@map("products")
}

model Lead {
  id        String     @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  score   Float
  status  LeadStatus @default(NEW)
  savedAt DateTime?
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, score])
  @@map("leads")
}

// ─── Inventory ─────────────────────────────────────────────────────────────

model InventoryItem {
  id    String @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  sku               String?
  fnsku             String?
  asin              String
  productName       String
  availableQuantity Int @default(0)
  reservedQuantity  Int @default(0)
  inboundQuantity   Int @default(0)
  totalQuantity     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, asin])
  @@index([orgId])
  @@index([asin])
  @@map("inventory_items")
}

// ─── Repricing ─────────────────────────────────────────────────────────────

model RepricingRule {
  id    String @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  asin       String
  title      String?
  minRoi     Float   @default(30)
  minProfit  Float   @default(5)
  strategy   String  @default("COMPETITIVE")
  floorPrice Float?  // optional hard floor — price never drops below this
  costBasis  Float?  // what you paid per unit; needed for the ROI/profit floor

  lastRecommendedPrice Float?
  lastDirection        String?
  lastRepricedAt       DateTime?
  lastPushedPrice      Float?     // last price actually pushed live to Amazon
  lastPushedAt         DateTime?
  isActive             Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history RepricingHistory[]

  @@unique([orgId, asin])
  @@index([orgId])
  @@map("repricing_rules")
}

model RepricingHistory {
  id     String @id @default(cuid())
  ruleId String
  rule   RepricingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  buyBoxPrice      Float?
  recommendedPrice Float
  direction        String
  riskScore        Float

  // Approval-queue lifecycle: a run creates PROPOSED (actionable) or HOLD (no
  // change) rows; the owner then pushes or rejects. PUSHED/FAILED are terminal.
  status        String    @default("PROPOSED") // PROPOSED | HOLD | PUSHED | FAILED | REJECTED | SUPERSEDED
  previousPrice Float?    // the live price this proposal would change away from
  sku           String?   // resolved seller SKU used for the push
  pushedAt      DateTime?
  pushError     String?

  createdAt DateTime @default(now())

  @@index([ruleId])
  @@index([status])
  @@map("repricing_history")
}

// ─── Amazon SP-API ─────────────────────────────────────────────────────────

model AmazonCredential {
  id    String @id @default(cuid())
  orgId String @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  sellerId       String
  marketplaceId  String
  accessToken    String   // AES-256-GCM encrypted
  refreshToken   String   // AES-256-GCM encrypted
  tokenExpiresAt DateTime?
  isActive       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("amazon_credentials")
}

// ─── Scan Jobs ─────────────────────────────────────────────────────────────

model ScanJob {
  id    String @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  type        String
  retailer    String?
  query       String?
  status      String   @default("PENDING")
  error       String?
  result      Json?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([orgId])
  @@index([status])
  @@index([orgId, type])
  @@map("scan_jobs")
}

// ─── Saved Search (scheduled weekly scans) ──────────────────────────────────

model SavedSearch {
  id    String @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  retailer String
  query    String
  enabled  Boolean @default(true)
  position Int     @default(0)

  lastRunAt   DateTime?
  lastResult  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([enabled])
  @@map("saved_searches")
}

// ─── Audit Log ─────────────────────────────────────────────────────────────

model AuditLog {
  id    String @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId   String?
  action   String
  resource String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([userId])
  @@index([orgId, createdAt])
  @@map("audit_logs")
}
