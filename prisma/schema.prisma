generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum Plan {
  STARTER
  PRO
  ENTERPRISE
}

enum Role {
  OWNER
  ADMIN
  ANALYST
  VIEWER
}

enum LeadStatus {
  NEW
  SAVED
  PURCHASED
  REJECTED
  EXPIRED
}

enum DemandLevel {
  LOW
  MEDIUM
  HIGH
  UNKNOWN // no BSR/sales-rank data returned — distinct from a confirmed weak rank
}

enum GatingRisk {
  LOW
  MEDIUM
  HIGH
}

enum UpcCacheStatus {
  HIT // detail actor returned a valid UPC
  MISS // actor succeeded but the item genuinely has no UPC in the feed
  FAILED // actor threw or returned malformed data
  TIMEOUT // actor call exceeded UPC_TIMEOUT_MS
}

enum CandidateStatus {
  RAW_CANDIDATE // imported, no Amazon data yet
  MATCHED // SP-API + Keepa pulled, profitability computed
  NEEDS_REVIEW // passed pipeline gates — owner must certify before delivery
  CERTIFIED // owner approved and pushed through pipeline for broadcast
  REJECTED // owner rejected or hard pipeline failure
  STALE // rescan: gone / out of stock / could not fetch
  NO_LONGER_PROFITABLE // rescan: spread collapsed
}

enum POStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

enum POItemStatus {
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum LeadTier {
  BASIC
  PRO
  PREMIUM
}

enum EntitlementSource {
  AUTO_BROADCAST // weekly cron delivery to receiveBroadcast orgs
  BACKFILL // registration seed — does not count toward weekly limit
  OWNER_GRANT // manually granted by platform operator
  CUSTOMER_MANUAL // customer submitted via ManualLeadEntry
  SUPPORT_BONUS // support/recovery override — never counts toward weekly limit
}

// ─── Multi-Tenant Core ─────────────────────────────────────────────────────

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  plan                 Plan     @default(STARTER)
  scanEnabled          Boolean  @default(false)
  isBroadcastSource    Boolean  @default(false)
  receiveBroadcast     Boolean  @default(true)
  // null = use system fallback (0.0875); 0.0000 = explicitly tax-exempt
  defaultSourceTaxRate Decimal? @db.Decimal(5, 4)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users                User[]
  subscription         Subscription?
  products             Product[]
  leads                Lead[]
  inventory            InventoryItem[]
  repricingRules       RepricingRule[]
  scanJobs             ScanJob[]
  savedSearches        SavedSearch[]
  amazonCred           AmazonCredential?
  auditLogs            AuditLog[]
  leadEntitlements     LeadEntitlement[]
  reimbursements       Reimbursement[]
  reimbursementSyncs   ReimbursementSync[]
  purchaseOrders       PurchaseOrder[]
  purchaseOrderItems   PurchaseOrderItem[]
  saleRecords          SaleRecord[]
  salesSyncs           SalesSync[]
  settlementRecords    SettlementRecord[]
  SaleAdjustmentRecord SaleAdjustmentRecord[]
  sourceCandidates     SourceCandidate[]

  @@index([slug])
  @@map("organizations")
}

model User {
  id       String       @id @default(cuid())
  email    String       @unique
  password String
  name     String?
  role     Role         @default(ANALYST)
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  passwordChangedAt DateTime @default(now())
  mfaEnabled        Boolean  @default(false)
  mfaSecret         String? // AES-256-GCM encrypted TOTP secret

  // Granular feature permission: allows a non-OWNER user to use the
  // "Add a lead manually" form on /dashboard/scanner. All other scanner
  // features (scheduled scans, scan history) remain OWNER-only.
  canManualLead Boolean @default(false)

  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([orgId])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // SHA-256 of the token sent in the email; raw token never stored
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Subscription {
  id                String       @id @default(cuid())
  orgId             String       @unique
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stripeCustomerId  String?      @unique
  stripeSubId       String?      @unique
  plan              Plan         @default(STARTER)
  status            String       @default("trialing")
  currentPeriodEnd  DateTime?
  trialEndsAt       DateTime?
  cancelAtPeriodEnd Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  billingEvents BillingEvent[]

  @@map("subscriptions")
}

model BillingEvent {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  stripeEventId  String       @unique
  type           String
  data           Json?
  createdAt      DateTime     @default(now())

  @@map("billing_events")
}

// ─── Products & Leads ──────────────────────────────────────────────────────

model Product {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Identifiers
  asin  String
  upc   String?
  ean   String?
  model String?
  brand String?

  // Product info
  title    String
  category String?
  imageUrl String?

  // Source data
  sourceUrl       String?
  sourceRetailer  String?
  sourcePrice     Float?
  sourceListPrice Float? // original "was" price before markdown
  onSale          Boolean? // retailer flagged on sale / rollback / clearance
  sourceTax       Float?
  sourceTaxRate   Decimal? @db.Decimal(5, 4) // rate used when Product profit was calculated
  sourceShipping  Float?

  // Discounts applied
  availableDiscounts Json? // { source, type, amount, percentage?, code? }[]
  discountSources    Json? // string[]
  finalCost          Float?

  // Amazon pricing data
  amazonUrl            String?
  buyBoxPrice          Float?
  lowestFbaPrice       Float?
  estimatedResellPrice Float?

  // Fee breakdown
  amazonFees      Float?
  referralFee     Float?
  fbaFee          Float?
  storageFee      Float?
  prepFee         Float?
  taxAmount       Float?
  totalLandedCost Float?

  // Computed profitability
  price  Float  @default(0)
  fees   Float  @default(0)
  profit Float  @default(0)
  roi    Float  @default(0)
  margin Float?

  // Sales rank
  bsr           Int?
  bsrPercentage Float?

  // Sales velocity
  monthlySales           Int? // estimated units sold per month (Keepa)
  expectedUnitsPerSeller Float? // monthlySales / (fbaSellers + 1) — your share

  // Seller / competition data
  buyBoxOwner      String?
  fbaSellers       Int?
  totalSellers     Int?
  amazonIsSeller   Boolean @default(false)
  amazonOwnsBuyBox Boolean @default(false)
  buyBoxSuppressed Boolean @default(false)
  isVariation      Boolean @default(false)
  parentAsin       String?
  roiImplausible   Boolean @default(false) // ROI high enough to suggest a bad match — verify
  rating           Float? // average star rating (0–5)
  reviewCount      Int? // total ratings/reviews on the listing
  lowReviews       Boolean @default(false) // few reviews — new/unestablished listing risk

  // Validation scores (all must be >= 95 to pass)
  matchMethod      String?
  matchConfidence  Float?
  identityScore    Float?
  urlScore         Float?
  priceScore       Float?
  inventoryScore   Float?
  validationPassed Boolean @default(false)

  // Gating & risk
  autoUngated          Boolean    @default(false)
  ipRiskScore          String     @default("LOW")
  gatingRisk           GatingRisk @default(LOW)
  hasHazmat            Boolean    @default(false)
  isBrandRestricted    Boolean    @default(false)
  isCategoryGated      Boolean    @default(false)
  isPrivateLabel       Boolean    @default(false)
  isGenericBrand       Boolean    @default(false)
  isMeltable           Boolean    @default(false)
  feeEstimateConfirmed Boolean    @default(false)

  // Real per-ASIN IP complaint history — set manually by an owner after an
  // actual takedown/complaint, not inferred. Once set, permanently blocks the
  // ASIN from becoming a lead again (broadcast-wide, same as the brand-name
  // heuristic but based on a confirmed incident instead of a guess).
  hasIpComplaintHistory Boolean @default(false)
  ipComplaintNote       String?

  // Set to true when this product's brand is in the active BrandBlock list.
  // Maintained by the brand-block API: set on block creation, cleared on block
  // deactivation. Prevents brand-blocked products from appearing in the default
  // customer Products view (same showBlocked opt-in as hasIpComplaintHistory).
  isBrandBlocked Boolean @default(false)

  // Demand & price stability
  demandLevel    DemandLevel @default(MEDIUM)
  priceStability String?
  priceTrend     String? // RISING | FLAT | DECLINING | UNKNOWN
  priceTrendPct  Float? // % change recent vs earlier window (negative = falling)

  // Canonical Keepa historical snapshot — raw time series (Amazon price/presence,
  // Buy Box price, sales rank, new offer count, etc; see KeepaHistorySnapshot in
  // src/lib/keepa.ts). Overwritten wholesale on each scan, not merged — Keepa
  // always returns the full available window itself. This is the single source
  // of historical truth that the confidence/timeline/historical-insight engines
  // (and future forecasting/BI phases) derive from; do not add parallel
  // per-feature history columns — extend this snapshot's shape instead.
  keepaHistory Json?

  // External links
  keepaLink String?

  // Free-text sourcing notes (promo codes, cart-quantity tricks, per-unit math).
  // Shared with all orgs — broadcast along with the rest of the product data.
  notes String?

  // Final lead score (0–100)
  score Float @default(0)

  // Freshness tracking — Phase 19.1
  priceCheckedAt  DateTime? // last Amazon buy box + fee verification
  sourceCheckedAt DateTime? // last retailer price verification
  freshnessStatus String    @default("NEEDS_RECHECK") // FRESH | NEEDS_RECHECK | STALE | NO_LONGER_PROFITABLE | OUT_OF_STOCK | PRICE_CHANGED | RISK_CHANGED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]

  @@unique([orgId, asin])
  @@index([orgId])
  @@index([orgId, score])
  @@index([orgId, roi])
  @@index([orgId, createdAt])
  @@index([orgId, freshnessStatus])
  @@map("products")
}

model Lead {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  score    Float
  status   LeadStatus @default(NEW)
  leadTier LeadTier   @default(BASIC)
  savedAt  DateTime?
  notes    String?

  // Lead purpose — Phase 20.1
  // Why this lead exists. Separate from leadTier (entitlement/delivery tier).
  // Allowed values: STARTER_SALES | PROFIT | PREMIUM | WATCHLIST
  // Default PROFIT: all historical leads were generated under the profit-first model.
  leadPurpose String @default("PROFIT")

  // Freshness tracking — Phase 19.1
  freshnessStatus    String    @default("NEEDS_RECHECK") // FRESH | NEEDS_RECHECK | STALE | NO_LONGER_PROFITABLE | OUT_OF_STOCK | PRICE_CHANGED | RISK_CHANGED
  freshnessCheckedAt DateTime? // last time this lead's underlying economics were verified

  // Source tax rate used when this lead's profit was calculated/displayed
  sourceTaxRate Decimal? @db.Decimal(5, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entitlements LeadEntitlement[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, score])
  @@index([orgId, leadTier])
  @@index([orgId, freshnessStatus])
  @@map("leads")
}

// Tracks which orgs are entitled to view a lead, when it was delivered, and
// why. This is the source of truth for access control and weekly-drop quota
// enforcement. Plan/tier limits are checked at delivery time only — an
// entitlement once granted persists until explicitly revoked, so historical
// leads remain visible across plan changes or downgrade events.
//
// Weekly delivery model: new leads drop every Monday at 06:00 Arizona time
// (America/Phoenix, UTC-7 year-round — no DST). deliveryWeekStart stores the
// UTC timestamp of that Monday-morning anchor for the drop that created this
// entitlement, enabling exact per-week quota queries:
//   WHERE orgId = ? AND deliveryWeekStart = <current week anchor>
//     AND countsTowardWeeklyLimit = true
// BACKFILL, OWNER_GRANT, and SUPPORT_BONUS entitlements set deliveryWeekStart
// null (they are outside normal weekly-drop accounting).
model LeadEntitlement {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadId String
  lead   Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  deliverySource          EntitlementSource
  countsTowardWeeklyLimit Boolean           @default(true)
  // Snapshot of the lead's tier at delivery time — future tier changes on the
  // lead do not retroactively alter existing entitlements.
  leadTierAtDelivery      LeadTier          @default(BASIC)

  // UTC timestamp of the Monday 06:00 Arizona-time anchor for the weekly drop
  // this entitlement belongs to. Null for BACKFILL, OWNER_GRANT, and
  // SUPPORT_BONUS entries that fall outside normal weekly-drop accounting.
  deliveryWeekStart DateTime?

  // Exact moment the lead was unlocked/granted for this org.
  deliveredAt DateTime @default(now())

  grantedByUserId String? // non-null for OWNER_GRANT; null for automated sources
  note            String? // operator note (OWNER_GRANT / SUPPORT_BONUS only)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, leadId])
  @@index([orgId])
  @@index([orgId, deliveryWeekStart])
  @@index([leadId])
  @@map("lead_entitlements")
}

// ─── Inventory ─────────────────────────────────────────────────────────────

model InventoryItem {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  sku               String?
  fnsku             String?
  asin              String
  productName       String
  availableQuantity Int     @default(0)
  reservedQuantity  Int     @default(0)
  inboundQuantity   Int     @default(0)
  totalQuantity     Int     @default(0)

  purchasedAt DateTime? // True acquisition date — user-supplied, never system-derived
  unitCost    Float? // Cost per unit at time of purchase — independent of RepricingRule

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, asin])
  @@index([orgId])
  @@index([asin])
  @@map("inventory_items")
}

// ─── Repricing ─────────────────────────────────────────────────────────────

model RepricingRule {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  asin       String
  title      String?
  minRoi     Float   @default(30)
  minProfit  Float   @default(5)
  strategy   String  @default("COMPETITIVE")
  floorPrice Float? // optional hard floor — price never drops below this
  costBasis  Float? // what you paid per unit; needed for the ROI/profit floor

  lastRecommendedPrice Float?
  lastDirection        String?
  lastRepricedAt       DateTime?
  lastPushedPrice      Float? // last price actually pushed live to Amazon
  lastPushedAt         DateTime?
  isActive             Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history RepricingHistory[]

  @@unique([orgId, asin])
  @@index([orgId])
  @@map("repricing_rules")
}

model RepricingHistory {
  id     String        @id @default(cuid())
  ruleId String
  rule   RepricingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  buyBoxPrice      Float?
  recommendedPrice Float
  direction        String
  riskScore        Float

  // Approval-queue lifecycle: a run creates PROPOSED (actionable) or HOLD (no
  // change) rows; the owner then pushes or rejects. PUSHED/FAILED are terminal.
  status        String    @default("PROPOSED") // PROPOSED | HOLD | PUSHED | FAILED | REJECTED | SUPERSEDED
  previousPrice Float? // the live price this proposal would change away from
  sku           String? // resolved seller SKU used for the push
  pushedAt      DateTime?
  pushError     String?
  reason        String? // engine explanation for why this price was recommended

  createdAt DateTime @default(now())

  @@index([ruleId])
  @@index([status])
  @@map("repricing_history")
}

// ─── Amazon SP-API ─────────────────────────────────────────────────────────

model AmazonCredential {
  id    String       @id @default(cuid())
  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  sellerId       String
  marketplaceId  String
  accessToken    String // AES-256-GCM encrypted
  refreshToken   String // AES-256-GCM encrypted
  tokenExpiresAt DateTime?
  isActive       Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("amazon_credentials")
}

// ─── Scan Jobs ─────────────────────────────────────────────────────────────

model ScanJob {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  type     String
  retailer String?
  query    String?
  status   String  @default("PENDING")
  error    String?
  result   Json?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([orgId])
  @@index([status])
  @@index([orgId, type])
  @@map("scan_jobs")
}

// ─── Saved Search (scheduled weekly scans) ──────────────────────────────────

model SavedSearch {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  retailer String
  query    String
  enabled  Boolean @default(true)
  position Int     @default(0)

  lastRunAt  DateTime?
  lastResult Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([enabled])
  @@map("saved_searches")
}

// ─── Audit Log ─────────────────────────────────────────────────────────────

model AuditLog {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId   String?
  action   String
  resource String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([userId])
  @@index([orgId, createdAt])
  @@map("audit_logs")
}

// ─── Profit Recovery Center ─────────────────────────────────────────────────

model Reimbursement {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Amazon report fields — exact column names from GET_FBA_REIMBURSEMENTS_DATA TSV
  reimbursementId             String // "reimbursement-id"
  approvalDate                DateTime // "approval-date"
  caseId                      String? // "case-id"
  amazonOrderId               String? // "amazon-order-id"
  reason                      String // "reason" e.g. REVERSAL_REIMBURSEMENT, LOST_INBOUND_SHIPMENT
  sku                         String? // "sku"
  fnsku                       String? // "fnsku"
  asin                        String? // "asin"
  productName                 String? // "product-name"
  condition                   String? // "condition"
  currencyUnit                String   @default("USD") // "currency-unit"
  amountPerUnit               Float // "amount-per-unit"
  amountTotal                 Float // "amount-total"
  quantityReimbursedCash      Int      @default(0) // "quantity-reimbursed-cash"
  quantityReimbursedInventory Int      @default(0) // "quantity-reimbursed-inventory"
  quantityReimbursedTotal     Int      @default(0) // "quantity-reimbursed-total"
  originalReimbursementId     String? // "original-reimbursement-id"
  originalReimbursementType   String? // "original-reimbursement-type"

  // EALLsource metadata
  importSource String @default("SP_API") // "SP_API" | "MANUAL_CSV"
  rawPayload   Json // full parsed row — preserved for audit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, reimbursementId])
  @@index([orgId])
  @@index([orgId, asin])
  @@index([orgId, approvalDate])
  @@map("reimbursements")
}

model ReimbursementSync {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  source           String    @default("SP_API") // "SP_API" | "MANUAL_CSV"
  status           String // "PENDING" | "RUNNING" | "DONE" | "FAILED"
  reportId         String? // Amazon report ID (SP_API only)
  reportDocumentId String? // Amazon report document ID (SP_API only)
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  recordsFound     Int?
  recordsUpserted  Int?
  error            String?

  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, startedAt])
  @@map("reimbursement_syncs")
}

// ─── Purchase Orders ────────────────────────────────────────────────────────

model PurchaseOrder {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  status          POStatus  @default(DRAFT)
  supplierName    String
  supplierOrderId String? // external reference (Amazon order ID, supplier PO#, etc.)
  orderDate       DateTime
  expectedDate    DateTime?
  notes           String?

  shippingCost Float @default(0)
  tax          Float @default(0)
  totalCost    Float @default(0) // sum of item totals + shipping + tax; maintained by service

  createdByUserId String? // User.id — nullable

  closedAt    DateTime?
  closeReason String?

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  orgId           String
  purchaseOrderId String
  org             Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  // Source references — plain strings, no enforced FK (survives lead/product deletion)
  leadId    String?
  productId String?

  // Product identity
  asin        String?
  sku         String?
  productName String
  sourceUrl   String?

  // Quantities
  quantityOrdered  Int
  quantityReceived Int @default(0)

  // Cost — required; no fabrication
  unitCost  Float
  totalCost Float // quantityOrdered × unitCost; maintained by service

  status     POItemStatus @default(ORDERED)
  receivedAt DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([purchaseOrderId])
  @@index([orgId, asin])
  @@map("purchase_order_items")
}

// ─── Sales & Profit Tracking ────────────────────────────────────────────────

model SaleRecord {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Deduplication — computed from order-item-id if available, else {amazonOrderId}#{asin}#{sku}
  dedupKey String // always set; used for @@unique

  // Source order references
  orderItemId   String? // order-item-id from the flat-file report
  amazonOrderId String?

  // Product identity
  asin        String?
  sku         String?
  productName String?

  // Sale details
  saleDate     DateTime // purchase-date from the report
  quantitySold Int

  // Revenue (from report — what the buyer paid)
  grossRevenue      Float // item-price total for this line (all units)
  itemTax           Float? // item-tax; null if not in report
  promotionDiscount Float? // item-promotion-discount + ship-promotion-discount; null if not in report
  netRevenue        Float // grossRevenue − (promotionDiscount ?? 0); stored separately for clarity

  // Order metadata
  fulfillmentChannel String? // "AFN" (FBA) or "MFN" (seller-fulfilled)
  orderStatus        String? // e.g. "Shipped", "Cancelled"

  // Amazon fees — null means not provided in this report (never default to 0)
  referralFee Float?
  fbaFee      Float?
  otherFees   Float?
  totalFees   Float?

  // Cost matching — resolved at import time; null = no cost data found
  unitCostUsed Float? // cost per unit
  costSource   String? // "PO_ITEM" | "INVENTORY" | "REPRICING" | "PRODUCT"

  // Derived profit — null when required inputs are missing; NEVER fabricated
  cogs                  Float? // unitCostUsed × quantitySold
  grossProfitBeforeFees Float? // netRevenue − cogs (no fees; only when cogs != null)
  grossRoiBeforeFees    Float? // grossProfitBeforeFees / cogs × 100
  realizedProfit        Float? // netRevenue − totalFees − cogs (only when BOTH totalFees and cogs != null)
  roi                   Float? // realizedProfit / cogs × 100 (only when realizedProfit != null)

  // Import metadata
  importSource String @default("MANUAL_CSV")
  rawPayload   Json // full parsed row for audit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleAdjustments SaleAdjustmentRecord[]

  @@unique([orgId, dedupKey])
  @@index([orgId])
  @@index([orgId, asin])
  @@index([orgId, sku])
  @@index([orgId, saleDate])
  @@map("sale_records")
}

model SalesSync {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  source          String // "MANUAL_CSV" | "MANUAL_SETTLEMENT" | "SP_API"
  status          String // "PENDING" | "RUNNING" | "DONE" | "FAILED"
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  recordsFound    Int?
  recordsUpserted Int?
  error           String?

  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, startedAt])
  @@map("sales_syncs")
}

// ─── Settlement Records ─────────────────────────────────────────────────────

model SettlementRecord {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Deduplication — required; prevents duplicate rows on re-import of the same settlement file
  dedupKey String

  // Settlement identity
  settlementId    String?
  transactionType String? // "Order" | "Refund" | "Adjustment" | "Transfer" | etc.
  postedDate      DateTime?

  // Order matching keys
  orderId       String? // order-id → matches SaleRecord.amazonOrderId
  orderItemCode String? // order-item-code → matches SaleRecord.orderItemId (primary)
  sku           String?

  // Fee / amount data (raw from report — amounts are signed as received)
  priceType      String? // "Principal" | "Tax" | "Shipping" | "Promotion"
  priceAmount    Float? // signed; positive = income, negative = charge
  itemFeeType    String? // "Commission" | "FBAPerUnitFulfillmentFee" | etc.
  itemFeeAmount  Float? // signed; negative in report
  otherFeeReason String? // other-fee-reason-description

  // Matching result — set after fee application
  matchedSaleRecordId String?

  importSource String @default("MANUAL_CSV")
  rawPayload   Json

  createdAt DateTime @default(now())

  saleAdjustment SaleAdjustmentRecord?

  @@unique([orgId, dedupKey])
  @@index([orgId])
  @@index([orgId, settlementId])
  @@index([orgId, orderId])
  @@index([orgId, orderItemCode])
  @@index([orgId, matchedSaleRecordId])
  @@map("settlement_records")
}

// ─── Refund & Adjustment Records ────────────────────────────────────────────

model SaleAdjustmentRecord {
  id String @id @default(cuid())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  saleRecordId String?
  saleRecord   SaleRecord? @relation(fields: [saleRecordId], references: [id])

  settlementRecordId String?           @unique
  settlementRecord   SettlementRecord? @relation(fields: [settlementRecordId], references: [id])

  settlementId    String?
  transactionType String?
  adjustmentType  String // "PRINCIPAL_REFUND" | "FEE_CREDIT" | "RETURN_FEE" | "TAX_REFUND" | "UNSUPPORTED"
  orderId         String?
  orderItemCode   String?
  sku             String?
  amountCategory  String? // raw priceType or itemFeeType label
  amount          Float // signed as received
  profitImpact    Float // sign-adjusted: negative = loss, positive = gain
  appliedToProfit Boolean @default(false)
  rawPayload      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, saleRecordId])
  @@index([orgId, orderItemCode])
  @@map("sale_adjustment_records")
}

// ─── Retailer UPC Cache ─────────────────────────────────────────────────────
//
// Global (cross-org) cache of Walmart UPC enrichment results. Each record
// stores the outcome of one pratikdani/walmart-product-scraper call so
// repeated scans of the same Walmart URL avoid re-calling the detail actor.
//
// Lookup order:
//   1. retailer + retailerItemId  (preferred — stable across slug changes)
//   2. retailer + normalizedSourceUrl  (fallback when itemId extraction fails)
//
// retailerItemId is nullable — Postgres treats two NULLs as distinct in a
// unique constraint, so rows without an itemId are only deduplicated by URL.
// Writes use the itemId key when itemId is present, URL key otherwise.

model RetailerUpcCache {
  id String @id @default(cuid())

  retailer            String
  retailerItemId      String? // Walmart numeric item ID (last URL path segment)
  normalizedSourceUrl String // url.split('?')[0].toLowerCase() — always set

  // Enriched data — null when not returned by the actor
  upc   String?
  ean   String?
  model String?
  brand String?
  title String?

  status        UpcCacheStatus
  failureReason String? // error summary for FAILED / TIMEOUT entries

  fetchedAt DateTime // when the actor call completed (or timed out)
  expiresAt DateTime // fetchedAt + TTL (30d HIT, 7d MISS, 3d FAILED/TIMEOUT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Primary key: retailer + itemId (only when itemId is non-null — NULLs are distinct)
  @@unique([retailer, retailerItemId])
  // Fallback key: retailer + normalised URL (covers cases without a parseable itemId)
  @@unique([retailer, normalizedSourceUrl])
  @@index([retailer, retailerItemId])
  @@index([retailer, normalizedSourceUrl])
  @@index([expiresAt])
  @@map("retailer_upc_cache")
}

// ─── Brand Blocklist ────────────────────────────────────────────────────────
//
// Global (cross-org) brand-level safety list. When a brand is blocked:
//   • future pipeline leads are rejected with outcome: 'brand_blocked'
//   • all active leads for that brand are marked REJECTED across all orgs
//   • Products with that brand get isBrandBlocked=true and are hidden from
//     the default customer Products view (same showBlocked opt-in as ASIN blocks)
//
// Records are NEVER deleted; deactivated via isActive=false + clearedAt so
// the full block/clear history is preserved for audit.
// normalizedBrand (lowercase+trimmed) is the deduplication key — re-blocking
// a cleared brand reactivates the existing row rather than inserting a duplicate.

// ─── Source Candidate (Hybrid Sourcing Foundation — Phase 18.1) ────────────
//
// Pre-pipeline staging for VA imports, manual entries, and future Apify scans.
// Sits between raw discovery and the existing Lead pipeline. The owner reviews
// and certifies candidates here before they are pushed through processRetailerProduct
// (with full safety gates — no force:true). Customers never see SourceCandidates
// directly; they receive Leads via the normal weekly broadcast.

model SourceCandidate {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Identifiers
  asin           String?
  upc            String?
  retailerItemId String? // Walmart item ID, Target DPCI, etc.

  // URLs
  retailerUrl           String // original URL as submitted
  normalizedRetailerUrl String // url stripped of query params + trailing slash, lowercased

  retailer String // "Walmart", "Target", etc.

  // Product info
  title String?
  brand String?

  // Source pricing at time of discovery
  sourcePrice     Float?
  sourceListPrice Float?
  onSale          Boolean?

  // Amazon pricing at last check (populated by enrichment job, not import)
  buyBoxPrice     Float?
  amazonCheckedAt DateTime?

  // Profitability snapshot (populated by enrichment job, not import)
  estimatedProfit Float?
  estimatedRoi    Float?
  sourceTaxRate   Decimal? @db.Decimal(5, 4) // rate used (or intended override) at evaluation time

  // Sourcing attribution
  sourceType String // "VA_IMPORT" | "APIFY_SCAN" | "MANUAL" | "RESCAN"
  sourceCost Float? // estimated USD cost to discover this candidate (0 for VA_IMPORT)
  scanJobId  String? // FK to ScanJob when sourceType = APIFY_SCAN

  // VA/operator notes — free text attached at import time
  vaNotes String?

  // Intended lead purpose — set before evaluation to select evaluation thresholds.
  // Allowed values: PROFIT | STARTER_SALES
  // Default PROFIT: all existing candidates were evaluated under the profit-first model.
  // STARTER_SALES enables lower resale floor ($5), lower profit floor ($1), no ROI floor.
  targetLeadPurpose String @default("PROFIT")

  // Certification workflow
  certStatus  CandidateStatus @default(RAW_CANDIDATE)
  certNotes   String?
  certifiedAt DateTime?
  certifiedBy String? // userId
  rejectedAt  DateTime?
  rejectedBy  String? // userId

  // Staleness tracking (populated by in-house rescan — Phase 18.3)
  lastCheckedAt DateTime?
  staleAt       DateTime?

  // FK to Product + Lead once certified and pipeline-processed (Phase 18.4+)
  productId String?
  leadId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, normalizedRetailerUrl])
  @@index([orgId, certStatus])
  @@index([orgId, retailer])
  @@index([orgId, sourceType])
  @@index([orgId, createdAt])
  @@map("source_candidates")
}

model BrandBlock {
  id              String    @id @default(cuid())
  brand           String // original brand name as entered by admin
  normalizedBrand String    @unique // LOWER(TRIM(brand)) — dedup + pipeline lookup key
  reason          String? // short public reason (e.g. "Private label — Astercook")
  note            String? // optional operator-only note
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdByUserId String?
  createdByEmail  String?
  clearedAt       DateTime?
  clearedByUserId String?
  clearedByEmail  String?

  @@index([isActive])
  @@index([normalizedBrand, isActive])
  @@map("brand_blocks")
}
